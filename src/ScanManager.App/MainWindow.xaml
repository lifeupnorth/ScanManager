<Window x:Class="ScanManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ScanManager.App.ViewModels"
        xmlns:ctl="clr-namespace:ScanManager.App.Controls"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="ScanManager"
        Width="1320" Height="860" MinWidth="960" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True">

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding ScanCommand}" />
        <KeyBinding Key="F5" Modifiers="Shift" Command="{Binding PreviewCommand}" />
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SaveCommand}" />
        <KeyBinding Key="P" Modifiers="Ctrl" Command="{Binding PrintCommand}" />
        <KeyBinding Key="O" Modifiers="Ctrl" Command="{Binding ImportCommand}" />
        <KeyBinding Key="Z" Modifiers="Ctrl" Command="{Binding UndoCommand}" />
        <KeyBinding Key="R" Modifiers="Ctrl" Command="{Binding RotateRightCommand}" />
        <KeyBinding Key="R" Modifiers="Ctrl+Shift" Command="{Binding RotateLeftCommand}" />
        <KeyBinding Key="Return" Command="{Binding ApplyCropCommand}" />
        <KeyBinding Key="Escape" Command="{Binding CancelCropCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== Command bar ===== -->
        <Border Grid.Row="0" Padding="10,8" BorderThickness="0,0,0,1" Style="{StaticResource SectionPanel}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Command="{Binding OpenSettingsCommand}" ToolTip="Settings, such as the default scan source"
                        Padding="12,6" AutomationProperties.Name="Settings">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE713;" />
                        <TextBlock Text="Settings" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
                <StackPanel Orientation="Horizontal">
                    <Button Command="{Binding ImportCommand}" ToolTip="Add image files as pages (Ctrl+O). You can also drop files on the window." Padding="12,6" Margin="0,0,6,0" AutomationProperties.Name="Add images">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8E5;" />
                            <TextBlock Text="Add images" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding SaveCommand}" ToolTip="Save all pages as PDF, TIFF, PNG or JPEG (Ctrl+S)" Padding="12,6" Margin="0,0,6,0" AutomationProperties.Name="Save">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE74E;" />
                            <TextBlock Text="Save" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding PrintCommand}" ToolTip="Print all pages (Ctrl+P)" Padding="12,6" Margin="0,0,6,0" AutomationProperties.Name="Print">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE749;" />
                            <TextBlock Text="Print" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>

                    <Border Style="{StaticResource ToolbarSeparator}" />

                    <Button Command="{Binding UndoCommand}" ToolTip="{Binding UndoDescription}" Padding="12,6" Margin="0,0,6,0" AutomationProperties.Name="Undo">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE7A7;" />
                            <TextBlock Text="Undo" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ClearPagesCommand}" ToolTip="Remove all pages and start a new document" Padding="12,6" AutomationProperties.Name="Clear all">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE894;" />
                            <TextBlock Text="Clear all" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="240" />
            </Grid.ColumnDefinitions>

            <!-- ===== Scan settings ===== -->
            <Border Grid.Column="0" BorderThickness="0,0,1,0" Style="{StaticResource SectionPanel}">
                <DockPanel>
                    <Grid DockPanel.Dock="Bottom" Margin="16,8,16,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Command="{Binding PreviewCommand}" HorizontalAlignment="Stretch" Padding="0,8"
                                ToolTip="Quick low-resolution scan of the whole glass, to choose the scan area (Shift+F5)" AutomationProperties.Name="Preview">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE890;" />
                                <TextBlock Text="Preview" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" Command="{Binding ScanCommand}" HorizontalAlignment="Stretch" Padding="0,8" ToolTip="Scan with the current settings (F5)"
                                Style="{DynamicResource AccentButtonStyle}" AutomationProperties.Name="Scan">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8FE;" />
                                <TextBlock Text="Scan" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="16,0,16,8" IsEnabled="{Binding IsIdle}">
                            <TextBlock Text="Scanner" Style="{StaticResource FieldLabel}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                                          DisplayMemberPath="Name" HorizontalAlignment="Stretch" />
                                <Button Grid.Column="1" Margin="6,0,0,0" Padding="9,6" Command="{Binding RefreshDevicesCommand}"
                                        ToolTip="Look for scanners again" AutomationProperties.Name="Look for scanners again">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" />
                                </Button>
                            </Grid>

                            <TextBlock Text="Source" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}" HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource EnumDisplay}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <CheckBox Content="Skip blank pages" IsChecked="{Binding SkipBlankPages}" Margin="0,8,0,0"
                                      Visibility="{Binding IsFeederSource, Converter={StaticResource BoolToVisibility}}"
                                      ToolTip="Drop pages that are (almost) empty, such as the blank backs of single-sided sheets" />

                            <TextBlock Text="Color" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding ColorModes}" SelectedItem="{Binding SelectedColorMode}" HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource EnumDisplay}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <TextBlock Text="Resolution" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding Resolutions}" SelectedItem="{Binding SelectedDpi}"
                                      ItemStringFormat="{}{0} dpi" HorizontalAlignment="Stretch" />

                            <TextBlock Text="Scan area" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding AreaPresets}" SelectedItem="{Binding SelectedAreaPreset}"
                                      DisplayMemberPath="Name" HorizontalAlignment="Stretch" />
                            <TextBlock Text="{Binding AreaDescription}" Style="{StaticResource Hint}" />

                            <DockPanel Margin="0,18,0,0">
                                <Button DockPanel.Dock="Right" Content="Reset" Padding="10,2" Command="{Binding ResetAdjustmentsCommand}"
                                        ToolTip="Reset brightness, contrast and threshold" />
                                <TextBlock Text="Adjustments" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </DockPanel>

                            <DockPanel Margin="0,10,0,0">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Brightness}" Width="32" TextAlignment="Right" />
                                <TextBlock Text="Brightness" />
                            </DockPanel>
                            <Slider Minimum="-100" Maximum="100" Value="{Binding Brightness}" TickFrequency="5" IsSnapToTickEnabled="True" />

                            <DockPanel Margin="0,8,0,0">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Contrast}" Width="32" TextAlignment="Right" />
                                <TextBlock Text="Contrast" />
                            </DockPanel>
                            <Slider Minimum="-100" Maximum="100" Value="{Binding Contrast}" TickFrequency="5" IsSnapToTickEnabled="True" />

                            <StackPanel Visibility="{Binding IsBlackAndWhite, Converter={StaticResource BoolToVisibility}}">
                                <DockPanel Margin="0,8,0,0">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding BlackWhiteThreshold}" Width="32" TextAlignment="Right" />
                                    <TextBlock Text="Black &amp; white threshold" />
                                </DockPanel>
                                <Slider Minimum="20" Maximum="240" Value="{Binding BlackWhiteThreshold}" TickFrequency="5" IsSnapToTickEnabled="True"
                                        ToolTip="Higher values turn more light-gray areas black" />
                            </StackPanel>

                            <TextBlock Text="{Binding AdjustmentNote}" Style="{StaticResource Hint}"
                                       Visibility="{Binding AdjustmentNote, Converter={StaticResource NotNullToVisibility}}" />
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ===== Preview / page view ===== -->
            <TabControl Grid.Column="1" SelectedIndex="{Binding ViewIndex}" Margin="8,8,8,0" BorderThickness="0">
                <TabItem Header="Scan area">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ctl:RegionSelector Source="{Binding PreviewImage}"
                                            ContentSize="{Binding BedSize}"
                                            Selection="{Binding NormalizedArea}"
                                            PlaceholderText="{Binding PreviewPlaceholder}" />
                        <TextBlock Grid.Row="1" Text="{Binding ScanAreaHint}" Style="{StaticResource Hint}" Margin="16,4,16,10" />
                    </Grid>
                </TabItem>

                <TabItem Header="Page" IsEnabled="{Binding HasPages}">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Padding="8,6">
                            <Grid>
                                <StackPanel Orientation="Horizontal"
                                            Visibility="{Binding IsCropMode, Converter={StaticResource InverseBoolToVisibility}}">
                                    <Button Command="{Binding RotateLeftCommand}" ToolTip="Rotate left (Ctrl+Shift+R)" Padding="10,6" Margin="0,0,4,0" AutomationProperties.Name="Rotate left">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7AD;" RenderTransformOrigin="0.5,0.5">
                                            <TextBlock.RenderTransform>
                                                <ScaleTransform ScaleX="-1" />
                                            </TextBlock.RenderTransform>
                                        </TextBlock>
                                    </Button>
                                    <Button Command="{Binding RotateRightCommand}" ToolTip="Rotate right (Ctrl+R)" Padding="10,6" Margin="0,0,4,0" AutomationProperties.Name="Rotate right">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7AD;" />
                                    </Button>
                                    <Button Command="{Binding Rotate180Command}" ToolTip="Turn upside down" Padding="10,6" Content="180°" />

                                    <Border Style="{StaticResource ToolbarSeparator}" />

                                    <Button Command="{Binding StartCropCommand}" ToolTip="Crop the page" Padding="12,6" AutomationProperties.Name="Crop">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE7A8;" />
                                            <TextBlock Text="Crop" Margin="8,0,0,0" />
                                        </StackPanel>
                                    </Button>

                                    <Border Style="{StaticResource ToolbarSeparator}" />

                                    <Button Command="{Binding MovePageUpCommand}" ToolTip="Move page earlier" Padding="10,6" Margin="0,0,4,0" AutomationProperties.Name="Move page earlier">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE74A;" />
                                    </Button>
                                    <Button Command="{Binding MovePageDownCommand}" ToolTip="Move page later" Padding="10,6" AutomationProperties.Name="Move page later">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE74B;" />
                                    </Button>

                                    <Border Style="{StaticResource ToolbarSeparator}" />

                                    <Button Command="{Binding DeletePageCommand}" ToolTip="Delete page (Del)" Padding="12,6" AutomationProperties.Name="Delete">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" />
                                            <TextBlock Text="Delete" Margin="8,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            Visibility="{Binding IsCropMode, Converter={StaticResource BoolToVisibility}}">
                                    <Button Command="{Binding ApplyCropCommand}" Style="{DynamicResource AccentButtonStyle}" Padding="12,6" Margin="0,0,6,0"
                                            ToolTip="Keep only the framed area (Enter)" AutomationProperties.Name="Apply crop">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8FB;" />
                                            <TextBlock Text="Apply crop" Margin="8,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding CancelCropCommand}" Padding="12,6" ToolTip="Leave the page as it is (Esc)" AutomationProperties.Name="Cancel">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" />
                                            <TextBlock Text="Cancel" Margin="8,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Text="Drag the frame or its handles; arrow keys nudge it." VerticalAlignment="Center" Margin="12,0,0,0" Opacity="0.75" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock DockPanel.Dock="Bottom" Text="{Binding SelectedPage.Details}" Style="{StaticResource Hint}" Margin="16,4,16,10" />

                        <ctl:RegionSelector Source="{Binding SelectedPageImage}"
                                            ContentSize="{Binding SelectedPage.PixelSize}"
                                            Selection="{Binding CropSelection}"
                                            ShowSelection="{Binding IsCropMode}"
                                            IsEditable="{Binding IsCropMode}"
                                            PlaceholderText="{Binding PagePlaceholder}" />
                    </DockPanel>
                </TabItem>
            </TabControl>

            <!-- ===== Page list ===== -->
            <Border Grid.Column="2" BorderThickness="1,0,0,0" Style="{StaticResource SectionPanel}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="14,14,14,8">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding PageCountText}" Opacity="0.75" VerticalAlignment="Center" />
                        <TextBlock Text="Document" FontWeight="SemiBold" />
                    </DockPanel>
                    <Grid>
                        <ListBox x:Name="PageList"
                                 ItemsSource="{Binding Pages}"
                                 SelectedItem="{Binding SelectedPage}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 AllowDrop="True"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 HorizontalContentAlignment="Stretch"
                                 PreviewMouseLeftButtonDown="PageList_PreviewMouseLeftButtonDown"
                                 PreviewMouseMove="PageList_PreviewMouseMove"
                                 DragOver="PageList_DragOver"
                                 Drop="PageList_Drop">
                            <ListBox.InputBindings>
                                <KeyBinding Key="Delete" Command="{Binding DeletePageCommand}" />
                            </ListBox.InputBindings>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:PageViewModel}">
                                    <StackPanel Margin="0,6" ToolTip="{Binding Details}">
                                        <Border Background="White" BorderBrush="#33000000" BorderThickness="1" HorizontalAlignment="Center">
                                            <Image Source="{Binding Thumbnail}" MaxWidth="170" MaxHeight="190" Stretch="Uniform" />
                                        </Border>
                                        <TextBlock Text="{Binding Title}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="Scanned pages appear here. Drag pages to reorder them."
                                   Style="{StaticResource Hint}" TextAlignment="Center" Margin="20,40,20,0" VerticalAlignment="Top"
                                   Visibility="{Binding HasPages, Converter={StaticResource InverseBoolToVisibility}}" />
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ===== Status bar ===== -->
        <Border Grid.Row="2" Padding="12,6" BorderThickness="0,1,0,0" Style="{StaticResource SectionPanel}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Command="{Binding CancelScanCommand}" Padding="12,3" Margin="12,0,0,0"
                        Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}" Content="Cancel scan" />
                <ProgressBar DockPanel.Dock="Right" Width="160" Height="4" Margin="12,0,0,0" VerticalAlignment="Center"
                             IsIndeterminate="{Binding IsBusy}"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
